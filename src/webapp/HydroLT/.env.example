# Copy this file to .env.local and fill in real values.
# If Firebase values are missing, the app runs in DEMO MODE with simulated data.

NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_DATABASE_URL=
NEXT_PUBLIC_FB_PROJECT_ID=

# Fallback UUID of this controller in the devices/{id} node.
# Only used before a user connects a device on /connect; each user links
# their own device via the Connect page after signing in.
NEXT_PUBLIC_DEVICE_ID=

# force simulated data even when Firebase is configured
NEXT_PUBLIC_DEMO_MODE=false

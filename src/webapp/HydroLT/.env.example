# Copy this file to .env.local and fill in real values.
# If Supabase values are missing, the app runs in DEMO MODE with simulated data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fallback UUID of this controller in the public.devices table.
# Only used before a user connects a device on /connect; each user links
# their own device via the Connect page after signing in.
NEXT_PUBLIC_DEVICE_ID=

# force simulated data even when Supabase is configured
NEXT_PUBLIC_DEMO_MODE=false

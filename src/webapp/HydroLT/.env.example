# Copy this file to .env.local and fill in real values.
# If Supabase values are missing, the app runs in DEMO MODE with simulated data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UUID of this controller in the public.devices table
NEXT_PUBLIC_DEVICE_ID=

# force simulated data even when Supabase is configured
NEXT_PUBLIC_DEMO_MODE=false
